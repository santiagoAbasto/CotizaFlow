{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/js tests/Browser vite.config.js vitest.config.ts package.json",
        "format:check": "prettier --check resources/js tests/Browser vite.config.js vitest.config.ts package.json",
        "lint": "oxlint --react-plugin --jsx-a11y-plugin --deny-warnings resources/js tests/Browser",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "oxlint": "^1.82.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vitest": "^5.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
