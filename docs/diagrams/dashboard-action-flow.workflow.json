    { "id": "query", "lane": "domain", "col": 2, "type": "backend", "label": "CommercialDashboardQuery", "sublabel": "agrupa por moneda", "width": 174 },
    { "id": "quotes", "lane": "data", "col": 2, "type": "database", "label": "Quotes + FollowUps", "sublabel": "scope de tenant", "tag": "sin FX", "width": 156 },
    { "id": "priorities", "lane": "dashboard", "col": 4, "type": "frontend", "label": "Prioridades", "sublabel": "vencido → hoy → sin seguimiento", "width": 174 },
    { "id": "quote", "lane": "seller", "col": 5, "type": "frontend", "label": "Abrir cotización", "sublabel": "actuar o programar", "width": 145 },
